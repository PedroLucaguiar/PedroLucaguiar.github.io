{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../PS/node_modules/@types/react"],
      "react/jsx-runtime": ["../PS/node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["../PS/node_modules/@types/react/jsx-dev-runtime"],
      "lucide-react": ["../PS/node_modules/lucide-react/dist/lucide-react.d.ts"],
      "clsx": ["../PS/node_modules/clsx/clsx.d.ts"],
      "tailwind-merge": ["../PS/node_modules/tailwind-merge/dist/types.d.ts"]
    },
    "types": ["react", "react-dom", "node"],
    "typeRoots": ["../PS/node_modules/@types"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
